# PTAL configuration.
#
# Looked up in this order: $PTAL_CONFIG, the current directory, the directory
# holding the binary, then ~/.config/ptal/.env. Installing the service pins the
# working directory, so putting this file in ~/.config/ptal/ makes `ptal` work
# from anywhere.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Create a bot by messaging @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Filled in automatically by `ptal setup`.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# GitHub credential - pick ONE of the three
# ---------------------------------------------------------------------------

# 1. The GitHub CLI, if you already use it. Nothing else to create: the token
#    stays in your system keyring. It is OAuth with the `repo` scope and passes
#    organization policies that reject fine-grained tokens.
USE_GH_CLI=false

# 2. A classic personal access token with the `repo` and `notifications`
#    scopes. If your repositories are in an organization with SSO, click
#    "Configure SSO -> Authorize" on the token after creating it.
#    https://github.com/settings/tokens/new?scopes=repo,notifications
GH_PAT_TOKEN=

# 3. No credential at all, for public repositories only. Set your username
#    here and leave the two above empty.
GITHUB_LOGIN=

# ---------------------------------------------------------------------------
# What to watch
# ---------------------------------------------------------------------------

# Limit to specific repositories or organizations, comma-separated. A value
# with a slash is a repository ("owner/name"); a bare name is a whole
# organization. Empty watches every pull request tied to you, anywhere.
WATCH_REPOS=

# Ignore pull requests with no activity in the last N days. This is the filter
# that cuts the most noise: pull requests abandoned long ago stay open and
# drown out the ones that need you. 0 disables it.
MAX_AGE_DAYS=14

# Include pull requests where the review was requested from your TEAM rather
# than from you by name. Off by default: on large teams this is the single
# largest source of noise.
INCLUDE_TEAM_REVIEWS=false

# Draft pull requests do not count as review requests.
IGNORE_DRAFTS=true

# Alert types never to send, comma-separated. Run `ptal events` to see the
# full list with what each one means. Empty sends everything.
#   e.g. MUTE_EVENTS=checks_failed,checks_fixed
MUTE_EVENTS=

# Send ONLY these alert types. Empty means all of them. MUTE_EVENTS is applied
# afterwards and wins, so a type named in both stays off.
#   e.g. ALERT_ON=review_requested,mentioned
ALERT_ON=

# Authors to skip entirely, comma-separated. Defaults to common bots.
IGNORE_AUTHORS=app/dependabot,app/renovate,app/github-actions

# ---------------------------------------------------------------------------
# Reviewing with Claude Code (optional)
#
# Requires the `claude` CLI installed and logged in. Uses your subscription,
# not an API key. See docs/claude-review.md.
# ---------------------------------------------------------------------------

# Repositories where the review button is offered. EMPTY DISABLES REVIEWING.
# A bare organization name enables everything under it.
#
# Consider this one carefully: enabling a repository means agreeing that its
# branches get read by an agent running on your machine. Claude is given
# read-only tools, so a pull request cannot execute anything - but reviewing
# your own project is still a different proposition from reviewing one where
# strangers open pull requests.
REVIEW_REPOS=

# Directory containing the .claude/ folder whose rules the review follows.
# Defaults to reviewer-rules/ beside this file.
REVIEW_RULES_DIR=

# Added to the prompt of every review. Per-review instructions given with
# `ptal review ... -m "..."` are appended after this, not instead of it.
#   e.g. REVIEW_INSTRUCTIONS=Always check for hardcoded credentials.
REVIEW_INSTRUCTIONS=

# Model override for reviews, e.g. opus. Empty uses the CLI default.
REVIEW_MODEL=

# Cap on a single review.
REVIEW_TIMEOUT=15m

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------

# Gap between full searches. Minimum 30s.
POLL_INTERVAL=2m

# Deliver without a sound during this range. Empty disables it.
QUIET_HOURS=

# Ceiling on messages per hour, guarding against floods.
MAX_PER_HOUR=30

# Skip GraphQL and use public search only. Useful when an organization policy
# blocks the token but the repositories are public.
PUBLIC_ONLY=false
