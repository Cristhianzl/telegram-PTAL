# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Create a bot by messaging @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Filled in automatically by `pullalerts setup`.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# GitHub credential - pick ONE of the three
# ---------------------------------------------------------------------------

# 1. The GitHub CLI, if you already use it. Nothing else to create: the token
#    stays in your system keyring. It is OAuth with the `repo` scope and passes
#    organization policies that reject fine-grained tokens.
USE_GH_CLI=false

# 2. A classic personal access token with the `repo` and `notifications`
#    scopes. If your repositories are in an organization with SSO, click
#    "Configure SSO -> Authorize" on the token after creating it.
#    https://github.com/settings/tokens/new?scopes=repo,notifications
GH_PAT_TOKEN=

# 3. No credential at all, for public repositories only. Set your username
#    here and leave the two above empty.
GITHUB_LOGIN=

# ---------------------------------------------------------------------------
# What to watch
# ---------------------------------------------------------------------------

# Limit to specific repositories or organizations, comma-separated. A value
# with a slash is a repository ("owner/name"); a bare name is a whole
# organization. Empty watches every pull request tied to you, anywhere.
WATCH_REPOS=

# Ignore pull requests with no activity in the last N days. This is the filter
# that cuts the most noise: pull requests abandoned long ago stay open and
# drown out the ones that need you. 0 disables it.
MAX_AGE_DAYS=14

# Include pull requests where the review was requested from your TEAM rather
# than from you by name. Off by default: on large teams this is the single
# largest source of noise.
INCLUDE_TEAM_REVIEWS=false

# Draft pull requests do not count as review requests.
IGNORE_DRAFTS=true

# Authors to skip entirely, comma-separated. Defaults to common bots.
IGNORE_AUTHORS=app/dependabot,app/renovate,app/github-actions

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------

# Gap between full searches. Minimum 30s.
POLL_INTERVAL=2m

# Deliver without a sound during this range. Empty disables it.
QUIET_HOURS=

# Ceiling on messages per hour, guarding against floods.
MAX_PER_HOUR=30

# Skip GraphQL and use public search only. Useful when an organization policy
# blocks the token but the repositories are public.
PUBLIC_ONLY=false
